{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "StockFlow",
    "Audience": "StockFlow.Clients",
    "SigningKey": "dev-only-signing-key-change-me-please-32chars+",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
